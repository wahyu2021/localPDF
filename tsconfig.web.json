{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "outDir": "./out/renderer",
    "rootDir": "./src/renderer"
  },
  "include": [
    "src/renderer/src/**/*",
    "src/shared/**/*"
  ]
}
